
@custom_secret host secret.example.com
handle @custom_secret {
	@loop header X-Syncloud-Custom-Proxy *
	error @loop 502
	forward_auth unix//var/snap/platform/current/authelia.socket {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
	reverse_proxy http://192.168.1.20:9090 {
		header_up X-Syncloud-Custom-Proxy 1
		header_up X-Real-IP {remote_host}
	}
}
